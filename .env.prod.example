# ============================================================================
# Plantilla de variables para PRODUCCIÓN / SERVIDOR DE EVENTO (`docker-compose.prod.yml`).
#
# USO:
#   cp .env.prod.example .env.prod
#   # Generar claves aleatorias con: openssl rand -hex 32
#   chmod 600 .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# NUNCA commitear `.env.prod` al repositorio.
# ============================================================================

# --- Dominios públicos (HTTPS vía Caddy) ------------------------------------
APP_DOMAIN=sorteo.ejemplo.com
AUTH_DOMAIN=auth.sorteo.ejemplo.com

# --- Perfiles activos (mínimo para evento: db/keycloak/events/frontend/caddy)
# Opciones:
#   events,frontend                        -> solo eventos + sorteos + check-in webhook/Excel
#   events,notifications,frontend          -> Banreservas: sorteos + correo al ganador
#   events,convocatorias,notifications,frontend -> completo con invitaciones y correos
COMPOSE_PROFILES=events,notifications,frontend

# --- PostgreSQL (generar claves únicas con `openssl rand -hex 32`) ----------
POSTGRES_USER=sorteo360
POSTGRES_PASSWORD=REEMPLAZAR_CON_OPENSSL_RAND_HEX_32
EVENTS_DB_PASSWORD=REEMPLAZAR_EVENTS_DB_PASSWORD
CONVOCATORIAS_DB_PASSWORD=REEMPLAZAR_CONVOCATORIAS_DB_PASSWORD
NOTIFICATIONS_DB_PASSWORD=REEMPLAZAR_NOTIFICATIONS_DB_PASSWORD
KEYCLOAK_DB_PASSWORD=REEMPLAZAR_KEYCLOAK_DB_PASSWORD

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=REEMPLAZAR_CON_CLAVE_FUERTE
EVENTS_SERVICE_CLIENT_SECRET=REEMPLAZAR_CON_SECRETO_REAL
# Obligatoria aunque el perfil `convocatorias` esté apagado: el realm la usa al importarse.
CONVOCATORIAS_SERVICE_CLIENT_SECRET=REEMPLAZAR_CON_SECRETO_REAL

# --- Archivos y cache de puerta ---------------------------------------------
RAFFLE_ATTENDANCE_CACHE_TTL_SECONDS=30
FILE_MAX_SIZE_BYTES=26214400
FILE_MAX_GALLERY_IMAGES_PER_EVENT=20

# --- Correo saliente (notification-service + convocatorias) -----------------
# Proveedor por decidir. El remitente debe tener SPF, DKIM y DMARC en su dominio.
# Con SendGrid: SMTP_HOST=smtp.sendgrid.net y SMTP_USERNAME=apikey.
NOTIFICATIONS_TRANSPORT=http
NOTIFICATIONS_FROM_ADDRESS=no-reply@ejemplo.com
SMTP_HOST=REEMPLAZAR_SMTP_DEL_PROVEEDOR
SMTP_PORT=587
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ALLOW_EXTERNAL_RELAY=true
# Solo con SendGrid y su Event Webhook configurado (con su clave pública). Con otro
# proveedor, false: si no, cada envío queda esperando noticias de entrega que nunca llegan.
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
SENDGRID_EVENT_WEBHOOK_ENABLED=false

# --- Landing comercial -------------------------------------------------------
# true cuando events-service tenga el registro de cuentas (A25). Con false, el
# landing no ofrece "Crear cuenta" y los planes invitan a escribir a CONTACT_EMAIL.
# Se pasa al build del frontend como VITE_SIGNUP_ENABLED y a events-service como
# Accounts__SignupEnabled: con false, /v1/accounts/signup y /activate responden 404.
SIGNUP_ENABLED=false
CONTACT_EMAIL=
