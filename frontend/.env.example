# Fuente de datos de la app.
#   mock — datos de demostración en memoria (no requiere backend)
#   http — consume eventos-service real
VITE_API_MODE=http

# URL base de eventos-service. Dejar VACÍA (recomendado en desarrollo): la app llama
# /v1 en su mismo origen y el dev server de Vite lo reenvía a http://localhost:5170
# (configurable con EVENTOS_PROXY_TARGET), evitando CORS. El directorio de OPT
# (/v1/opts) es de crm-service y va a http://localhost:5180 (CRM_PROXY_TARGET); el
# historial de envíos (/v1/notifications) va a http://localhost:5190
# (NOTIFICATIONS_PROXY_TARGET).
# Solo definirla para llamar al API directamente desde otro origen; en ese caso el
# servicio debe permitir CORS para el origen del frontend.
VITE_EVENTOS_API_URL=

# Keycloak visto desde el NAVEGADOR (realm sorteo360, cliente publico sorteo360-app).
# En local es el puerto publicado KEYCLOAK_PORT del compose raiz.
VITE_KEYCLOAK_URL=http://localhost:8082
