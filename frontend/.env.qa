# Configuración de Entorno QA — Sorteo360 Frontend
# Para desplegar en QA, únicamente actualizar las variables en este archivo o en las variables de entorno del servidor CI/CD / Docker / Kubernetes.

# Modo de consumo HTTP real activado
VITE_API_MODE=http

# URL Base del Microservicio eventos-service en QA
# Dejar vacío si NGINX reenvía /v1 en el mismo dominio (ej: https://sorteo360.example.com/v1)
# O especificar la URL completa del backend de QA si es un dominio independiente:
VITE_EVENTOS_API_URL=https://sorteo360.example.com

# Servidor de Autenticación Keycloak en QA
VITE_KEYCLOAK_URL=https://sorteo360.example.com
VITE_KEYCLOAK_REALM=sorteo360
VITE_KEYCLOAK_CLIENT_ID=sorteo360-app
