meta {
  name: 08 Cancel Event
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v{{apiVersion}}/events/:eventId/cancel
  body: json
  auth: inherit
}

params:path {
  eventId: {{lcEventId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": "El cliente pospuso la gira (flujo Bruno)."
  }
}

assert {
  res.status: eq 200
  res.body.status: eq cancelled
  res.body.cancellationReason: eq El cliente pospuso la gira (flujo Bruno).
}
