meta {
  name: 01 Create Event
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v{{apiVersion}}/events
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "Roadshow",
    "name": "Roadshow Ciclo de Vida (Bruno)",
    "startDate": "2026-10-01",
    "endDate": "2026-10-05",
    "optOfficeId": "{{optOfficeId}}",
    "language": "es",
    "invitedCount": 60,
    "city": "Lisboa",
    "country": "Portugal"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("lcEventId", res.getBody());
    console.log("lcEventId =", bru.getVar("lcEventId"));
  }
}

assert {
  res.status: eq 201
}
