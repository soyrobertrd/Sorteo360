meta {
  name: 11 Get Feria City
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v{{apiVersion}}/events/:eventId
  body: none
  auth: inherit
}

params:path {
  eventId: {{gcFeriaEventId}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("gcFeriaCityId", res.getBody().cities[0].id);
    console.log("gcFeriaCityId =", bru.getVar("gcFeriaCityId"));
  }
}

assert {
  res.status: eq 200
  res.body.cities.length: eq 1
}

docs {
  Captura el id de la ciudad de la Feria.
}
