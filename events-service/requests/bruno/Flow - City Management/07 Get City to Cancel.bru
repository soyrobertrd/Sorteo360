meta {
  name: 07 Get City to Cancel
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v{{apiVersion}}/events/:eventId
  body: none
  auth: inherit
}

params:path {
  eventId: {{gcCancelEventId}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("gcCancelCityId", res.getBody().cities[0].id);
    console.log("gcCancelCityId =", bru.getVar("gcCancelCityId"));
  }
}

assert {
  res.status: eq 200
  res.body.cities.length: eq 1
}

docs {
  Captura el id de la ciudad del evento que se cancela a continuación.
}
