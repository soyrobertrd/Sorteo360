meta {
  name: 02 Create Service Supplier
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v{{apiVersion}}/service-suppliers
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "category": "{{category}}",
    "companyId": "{{companyId}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("serviceSupplierId", res.getBody());
    console.log("serviceSupplierId =", bru.getVar("serviceSupplierId"));
  }
}

assert {
  res.status: eq 201
}
