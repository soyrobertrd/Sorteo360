meta {
  name: 01 Create Event
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v{{apiVersion}}/events
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "Roadshow",
    "name": "Roadshow E2E (Bruno)",
    "startDate": "2026-09-01",
    "endDate": "2026-09-05",
    "optOfficeId": "{{optOfficeId}}",
    "language": "es",
    "invitedCount": 120,
    "city": "Madrid",
    "country": "España"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("eventId", res.getBody());
    console.log("eventId =", bru.getVar("eventId"));
  }
}

assert {
  res.status: eq 201
}
