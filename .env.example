# ============================================================================
# Plantilla de variables de entorno para el stack local de Sorteo360.
#
# USO: copiar a `.env` (que está en .gitignore) y ajustar valores.
#      cp .env.example .env
#
# Compose lee `.env` automáticamente. NUNCA commitear `.env` con secretos reales.
# Para despliegue en servidor ver `.env.prod.example` y `docs/deploy-sorteo360.md`.
# ============================================================================

# --- Perfiles de Compose ----------------------------------------------------
# "all" levanta todos los servicios. Agregá "tools" para Adminer, etc.
# Ejemplos:  all   |   all,tools   |   events   |   events,tools
COMPOSE_PROFILES=all

# --- PostgreSQL (infraestructura compartida) --------------------------------
POSTGRES_USER=sorteo360
POSTGRES_PASSWORD=localdev
POSTGRES_PORT=5432
# Un login por servicio: cada servicio y Keycloak entran a su propia base con
# su login (events_app, convocatorias_app, ...) y no con el superusuario, que queda
# para administración y para `postgres-roles`. En producción cada clave debe ser
# aleatoria: `openssl rand -hex 32`.
EVENTS_DB_PASSWORD=localdev
CONVOCATORIAS_DB_PASSWORD=localdev
NOTIFICATIONS_DB_PASSWORD=localdev
KEYCLOAK_DB_PASSWORD=localdev

# --- Keycloak (identidad, infraestructura compartida) ------------------------
# Consola de administración en http://localhost:${KEYCLOAK_PORT}.
KEYCLOAK_PORT=8082
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=localdev
# Hostname público de Keycloak (solo producción, ej. https://auth.sorteo360.local)
# KEYCLOAK_HOSTNAME=
# Secretos de clientes confidenciales de servicios (client credentials):
EVENTS_SERVICE_CLIENT_SECRET=localdev-events-service
CONVOCATORIAS_SERVICE_CLIENT_SECRET=localdev-convocatorias-service

# --- Imágenes (registry / tag) ----------------------------------------------
REGISTRY=sorteo360
TAG=local

# --- Entorno de ASP.NET Core ------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# --- Lista de la puerta del sorteo (events-service) -------------------------
# Segundos que events-service considera vigente su copia de quién está en la
# puerta de un evento, para las pantallas de armado del sorteo. Cero lee en cada
# consulta. Arrancar el sorteo siempre lee en vivo.
RAFFLE_ATTENDANCE_CACHE_TTL_SECONDS=30

# --- Límites de subida de archivos (events-service) -------------------------
# Tamaño máximo de un archivo, en bytes (25 MB por omisión) y tope de galería.
FILE_MAX_SIZE_BYTES=26214400
FILE_MAX_GALLERY_IMAGES_PER_EVENT=20

# --- Convocatorias ----------------------------------------------------------
# `stub` registra correos en stub_notification; `http` envía vía notification-service.
NOTIFICATIONS_TRANSPORT=stub

# --- Notificaciones (notification-service) ----------------------------------
# En local corre contra Mailpit; en producción contra SMTP con StartTLS.
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_REQUIRE_TLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ALLOW_EXTERNAL_RELAY=false
# SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
# SENDGRID_EVENT_WEBHOOK_ENABLED=true
# MAILPIT_MAX_MESSAGES=500

# --- Puertos publicados al host (host:contenedor) ---------------------------
EVENTS_PORT=5170
CONVOCATORIAS_PORT=5185
NOTIFICATIONS_PORT=5190
MAILPIT_UI_PORT=8025
FRONTEND_PORT=5175
ADMINER_PORT=8081
